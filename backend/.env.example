# Local Docker Compose (see docker-compose.yml):
# DATABASE_URL=postgresql://detonate:detonate@localhost:5432/detonate

# Supabase: Project Settings → Database → Connection string → URI (Session or Direct)
# Append ?sslmode=require if not present. Guide: ../docs/SUPABASE.md
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# Redis is not from Supabase — local Docker, Upstash, etc. API works if redis check fails.
REDIS_URL=redis://localhost:6379/0
API_CORS_ORIGINS=http://localhost:3000
RUNS_PERSIST=1

# Clerk (optional — JWT verification for Google sign-in)
# CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
